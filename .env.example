# Copy this file to .env and fill in your own values: cp .env.example .env
# .env is gitignored, so your keys stay out of version control.

# --- The agent under test (needed from Tutorial 1) ---
# Any OpenAI-compatible endpoint that supports the Responses API and strict
# JSON-schema output. Give the API root only, usually ending in /v1:
# the OpenAI SDK appends /responses itself.
INFERENCE_BASE_URL=https://api.openai.com/v1
# API key for that endpoint.
INFERENCE_API_KEY=your-inference-api-key
# Model ID to use for the agent, as named by your provider.
INFERENCE_MODEL_NAME=your-model-name

# --- The judge: Jev, via the TypeSafe SDK (needed from Tutorial 3) ---
# Give the root only: the TypeSafe SDK appends /v1/systemone itself.
TYPESAFE_BASE_URL=https://opencode.ai/zen
# API key for that endpoint.
TYPESAFE_API_KEY=your-typesafe-api-key
# Pin the model version. The default, jev-latest, can fail with
# "400 Model is unavailable" on some gateways.
TYPESAFE_MODEL_NAME=jev-1.13

# --- Golden generation (needed from Tutorial 4) ---
# DeepEval's Synthesizer uses OpenAI models by default, and reads this key.
OPENAI_API_KEY=your-openai-api-key

# --- DeepEval settings ---
# 0 hides DeepEval's trace-posting notices, which otherwise clutter the
# agent's output. The agent's tracing is used in later tutorials.
CONFIDENT_TRACE_VERBOSE=0
# Folder where `deepeval test run` saves each run's results as JSON.
DEEPEVAL_RESULTS_FOLDER=./deepeval_results/
